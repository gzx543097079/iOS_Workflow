#!/usr/bin/env python3
"""Portable iOS project workflow generator (stdlib only)."""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEFAULTS_PATH = ROOT / "config" / "defaults.jsonc"
DESIGN_TOKENS_PATH = ROOT / "config" / "design-tokens.jsonc"
VALID = {
    "language": ("swift", "objc"),
    "ui": ("swiftui", "uikit"),
    "architecture": ("mvvm", "mvc"),
    "dependency_manager": ("pod", "spm", "carthage", "none"),
    "default_language_mode": ("system", "fixed"),
    "comment_level": (1, 2, 3, 4),
}


class WorkflowError(Exception):
    pass


def strip_jsonc_comments(content):
    """Remove // comments while preserving comment-like text inside strings."""
    result = []
    in_string = False
    escaped = False
    index = 0
    while index < len(content):
        character = content[index]
        if in_string:
            result.append(character)
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == '"':
                in_string = False
            index += 1
            continue
        if character == '"':
            in_string = True
            result.append(character)
            index += 1
            continue
        if character == "/" and index + 1 < len(content) and content[index + 1] == "/":
            while index < len(content) and content[index] not in "\r\n":
                index += 1
            continue
        result.append(character)
        index += 1
    return "".join(result)


def load_jsonc(path, label):
    try:
        return json.loads(strip_jsonc_comments(path.read_text(encoding="utf-8")))
    except (OSError, json.JSONDecodeError) as exc:
        raise WorkflowError(f"无法读取{label} {path}: {exc}") from exc


def load_defaults():
    return load_jsonc(DEFAULTS_PATH, "默认配置")


def load_design_tokens():
    return load_jsonc(DESIGN_TOKENS_PATH, "UI Token 配置")


def swift_identifier(name):
    parts = re.findall(r"[A-Za-z0-9]+", name)
    value = "".join(part[:1].upper() + part[1:] for part in parts)
    if not value or value[0].isdigit():
        raise WorkflowError("项目名必须包含字母，且转换后不能以数字开头")
    return value


def validate_options(options):
    required = (
        "language", "ui", "architecture", "bundle_id_prefix", "bundle_id", "deployment_target",
        "navigation_enabled", "dependency_manager",
        "swift_version", "marketing_version", "build_number", "organization_name",
        "objc_class_prefix", "development_team", "code_sign_style", "target_devices",
        "default_language_mode", "default_localization", "supported_localizations",
        "include_unit_tests", "include_ui_tests", "test_framework", "comment_level",
        "strict_concurrency", "warnings_as_errors", "generate_privacy_manifest",
        "generate_xcodeproj",
    )
    missing = [key for key in required if key not in options]
    if missing:
        raise WorkflowError("默认配置缺少字段: " + ", ".join(missing))
    for key, allowed in VALID.items():
        if options[key] not in allowed:
            raise WorkflowError(f"{key} 必须是: {', '.join(map(str, allowed))}")
    if options["language"] == "objc" and options["ui"] == "swiftui":
        raise WorkflowError("Objective-C 不能直接使用 SwiftUI；请选择 --ui uikit 或 --language swift")
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9]*(\.[A-Za-z][A-Za-z0-9-]*)+", options["bundle_id_prefix"]):
        raise WorkflowError("bundle id prefix 格式无效，例如 com.example")
    if not re.fullmatch(r"\d+(\.\d+)?", str(options["deployment_target"])):
        raise WorkflowError("deployment target 格式无效，例如 17.0")
    if options["language"] == "objc" and not re.fullmatch(r"[A-Z]{2,3}", options["objc_class_prefix"]):
        raise WorkflowError("Objective-C 类前缀必须是 2–3 个大写字母，例如 APP")
    bundle_id = options.get("bundle_id", "")
    if bundle_id and not re.fullmatch(r"[A-Za-z][A-Za-z0-9-]*(\.[A-Za-z][A-Za-z0-9-]*)+", bundle_id):
        raise WorkflowError("完整 bundle id 格式无效，例如 com.example.myapp")
    if not re.fullmatch(r"\d+(\.\d+)*", str(options["swift_version"])):
        raise WorkflowError("Swift 版本格式无效，例如 5.10")
    if not re.fullmatch(r"\d+(\.\d+){1,2}", str(options["marketing_version"])):
        raise WorkflowError("marketing version 格式无效，例如 1.0")
    if not str(options["build_number"]).strip():
        raise WorkflowError("build number 不能为空")
    if options["code_sign_style"] not in ("automatic", "manual"):
        raise WorkflowError("code sign style 必须是 automatic 或 manual")
    devices = options["target_devices"]
    if not devices or any(device not in ("iphone", "ipad") for device in devices):
        raise WorkflowError("target devices 至少包含 iphone 或 ipad")
    if not options["supported_localizations"] or options["default_localization"] not in options["supported_localizations"]:
        raise WorkflowError("默认本地化语言必须包含在 supported localizations 中")
    if options["test_framework"] != "xctest":
        raise WorkflowError("当前 test framework 仅支持 xctest")
    if options["strict_concurrency"] not in ("minimal", "targeted", "complete"):
        raise WorkflowError("strict concurrency 必须是 minimal、targeted 或 complete")
    boolean_keys = (
        "navigation_enabled", "include_unit_tests", "include_ui_tests", "warnings_as_errors",
        "generate_privacy_manifest", "generate_xcodeproj",
    )
    if any(not isinstance(options[key], bool) for key in boolean_keys):
        raise WorkflowError("开关配置必须使用 true 或 false，不能使用字符串")


def write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content.strip() + "\n", encoding="utf-8")


def lower_camel(value):
    parts = value.split("_")
    return parts[0] + "".join(part[:1].upper() + part[1:] for part in parts[1:])


def upper_camel(value):
    return "".join(part[:1].upper() + part[1:] for part in value.split("_"))


def generated_code_role(path):
    name = path.name
    if name == "main.m" or name.endswith("App.swift"):
        return "声明应用程序入口。"
    if "AppDelegate" in name:
        return "管理应用生命周期与 scene 配置。"
    if "SceneDelegate" in name:
        return "创建窗口并装配根页面。"
    if "DesignTokens" in name:
        return "集中提供颜色、间距、字体和尺寸等设计 token。"
    if "LocalizationService" in name:
        return "加载本地化资源、持久化语言选择并广播语言变化。"
    if "AppLanguage" in name:
        return "定义应用支持的语言与首次启动语言策略。"
    if "ViewModel" in name:
        return "管理页面展示状态与用户意图。"
    if "ViewController" in name:
        return "渲染 UIKit 页面并转发用户操作。"
    if "Controller" in name and path.suffix == ".swift":
        return "协调 SwiftUI 页面状态与交互。"
    if name.endswith("View.swift"):
        return "渲染 SwiftUI 页面并转发用户操作。"
    if "UITests" in name:
        return "验证应用的关键界面流程。"
    if "Tests" in name:
        return "验证应用的核心业务行为。"
    return "承载当前模块的生成代码。"


def generated_code_approach(path):
    name = path.name
    if "SceneDelegate" in name:
        return "使用 scene 生命周期创建 UIWindow，并在单一入口装配根导航结构。"
    if "DesignTokens" in name:
        return "把设计参数集中为语义化常量，避免业务页面散落样式数值。"
    if "ViewModel" in name:
        return "由 ViewModel 暴露只读展示状态，使页面只负责渲染和事件转发。"
    if "ViewController" in name or name.endswith("View.swift"):
        return "通过系统组件和约束构建页面，并把业务状态委托给对应 Model。"
    if "Tests" in name:
        return "采用 Arrange、Act、Assert 结构隔离条件并验证可观察结果。"
    return "保持入口和模块边界清晰，复杂行为应下沉到可测试的独立类型。"


def generated_method_name(line):
    swift_match = re.search(r"\bfunc\s+([A-Za-z_][A-Za-z0-9_]*)", line)
    if swift_match:
        return swift_match.group(1)
    if re.match(
        r"\s*(?:(?:public|private|internal|fileprivate|required|convenience|override)\s+)*init[?!]?\s*\(",
        line,
    ):
        return "init"
    objc_match = re.match(r"\s*[+-]\s*\([^)]*\)\s*([A-Za-z_][A-Za-z0-9_]*)", line)
    return objc_match.group(1) if objc_match else None


def generated_method_role(name):
    known_roles = {
        "init": "初始化当前类型及其必要依赖。",
        "application": "响应应用创建新 scene 的请求并返回 scene 配置。",
        "scene": "在 scene 连接时创建窗口、装配根页面并显示界面。",
        "viewDidLoad": "在页面加载后完成基础样式、视图层级和约束配置。",
        "configureView": "创建页面控件、应用设计 token 并建立布局约束。",
        "configureNavigation": "配置导航栏操作及其事件入口。",
        "updateLocalizedContent": "根据当前语言刷新页面标题、正文和无障碍文案。",
        "showSettings": "创建设置页面并压入当前导航栈。",
        "languageDidChange": "响应语言变化通知并刷新当前页面。",
        "setLanguage": "更新当前语言、持久化选择并发送变化通知。",
        "string": "从当前语言资源包读取指定 key 的本地化文案。",
        "defaultLanguageMode": "从应用配置中解析首次启动语言策略。",
        "initialLanguage": "结合语言策略和默认地区计算首次使用的语言。",
        "displayName": "返回语言选项在设置页展示的名称。",
        "selectLanguage": "校验列表索引并应用对应的语言选择。",
        "numberOfSections": "返回语言设置列表的分区数量。",
        "tableView": "处理语言列表的数据展示或用户选择事件。",
        "testExample": "执行模板单元测试，确认测试 target 可以正常运行。",
        "testLaunch": "启动应用并确认 UI 测试 target 可以访问应用进程。",
    }
    if name.startswith("test"):
        return f"验证 {name} 对应场景的预期结果。"
    return known_roles.get(name, f"执行 {name} 对应的业务或界面操作。")


SYSTEM_METHOD_NAMES = {
    "application",
    "scene",
    "viewDidLoad",
    "viewWillAppear",
    "viewDidAppear",
    "viewWillDisappear",
    "viewDidDisappear",
    "didReceiveMemoryWarning",
    "traitCollectionDidChange",
    "numberOfSections",
    "tableView",
    "collectionView",
}


def should_annotate_method(line, method_name):
    """Return false for methods supplied by or inherited from an Apple framework."""
    if method_name in SYSTEM_METHOD_NAMES:
        return False
    if re.search(r"\boverride\b", line):
        return False
    if method_name == "init" and re.search(r"\b(required|override)\b", line):
        return False
    return True


def annotate_declarations(content, path, level):
    annotated = []
    excluded_method_depth = None
    excluded_method_opened = False
    for line in content.splitlines():
        stripped = line.strip()
        if stripped.startswith((
            "/// 类型职责：",
            "/// 方法职责：",
            "/// 属性说明：",
            "// 关键逻辑：",
            "/// 保存或提供 ",
            "/// 保存 ",
            "// 处理当前条件、分支或数据遍历。",
        )):
            continue
        natural_comment = stripped.removeprefix("/// ")
        if natural_comment in (generated_code_role(path), generated_code_approach(path)):
            continue
        if natural_comment in {generated_method_role(name) for name in (
            "init", "configureView", "configureNavigation", "updateLocalizedContent",
            "showSettings", "languageDidChange", "setLanguage", "string",
            "defaultLanguageMode", "initialLanguage", "displayName", "selectLanguage",
            "testExample", "testLaunch",
        )}:
            continue
        if re.fullmatch(r"(?:执行 .+ 对应的业务或界面操作。|验证 .+ 对应场景的预期结果。)", natural_comment):
            continue
        if excluded_method_depth is not None:
            annotated.append(line)
            if "{" in line:
                excluded_method_opened = True
            excluded_method_depth += line.count("{") - line.count("}")
            if excluded_method_opened and excluded_method_depth <= 0:
                excluded_method_depth = None
                excluded_method_opened = False
            continue
        indent = line[:len(line) - len(line.lstrip())]
        type_match = re.search(r"\b(class|struct|enum)\s+([A-Za-z_][A-Za-z0-9_]*)", stripped)
        objc_type_match = re.match(r"@interface\s+([A-Za-z_][A-Za-z0-9_]*)", stripped)
        method_name = generated_method_name(line)
        if method_name and not should_annotate_method(line, method_name):
            annotated.append(line)
            if not stripped.endswith(";"):
                excluded_method_depth = line.count("{") - line.count("}")
                excluded_method_opened = "{" in line
                if excluded_method_opened and excluded_method_depth <= 0:
                    excluded_method_depth = None
                    excluded_method_opened = False
            continue
        if type_match or objc_type_match:
            if level >= 2:
                annotated.append(f"{indent}/// {generated_code_role(path)}")
                if level >= 3:
                    annotated.append(f"{indent}/// {generated_code_approach(path)}")
        elif method_name and level >= 3:
            annotated.append(f"{indent}/// {generated_method_role(method_name)}")
        elif level == 4:
            property_match = re.search(r"\b(?:let|var)\s+([A-Za-z_][A-Za-z0-9_]*)", stripped)
            objc_property_match = re.match(r"@property.*\s([A-Za-z_][A-Za-z0-9_]*)\s*;", stripped)
            if property_match:
                annotated.append(f"{indent}/// 保存或提供 {property_match.group(1)} 对应的状态与依赖。")
            elif objc_property_match:
                annotated.append(f"{indent}/// 保存 {objc_property_match.group(1)} 对应的状态或依赖。")
            elif re.match(r"(if|guard|switch|for)\b", stripped):
                annotated.append(f"{indent}// 处理当前条件、分支或数据遍历。")
        annotated.append(line)
    return "\n".join(annotated) + "\n"


def strip_generated_file_header(content):
    """Remove legacy file metadata headers generated by earlier workflow versions."""
    lines = content.splitlines()
    if lines and lines[0].strip() == "//":
        index = 1
        while index < len(lines) and lines[index].lstrip().startswith("//"):
            index += 1
        header = "\n".join(lines[:index])
        metadata_markers = ("文件名：", "项目：", "创建时间：", "Git：", "Created by")
        if index >= 3 and any(marker in header for marker in metadata_markers):
            return "\n".join(lines[index:]).lstrip("\n") + "\n"
    if lines and lines[0] == "// 由 iosflow 工作流生成并维护。":
        remove_count = 3 if len(lines) > 2 and not lines[2].strip() else 2
        return "\n".join(lines[remove_count:]).lstrip("\n") + "\n"
    return content


def strip_generated_file_explanations(content):
    prefixes = (
        "// 文件职责：",
        "// 实现思路：",
        "// 技术选型：",
        "// 维护提示：",
    )
    lines = [line for line in content.splitlines() if not line.strip().startswith(prefixes)]
    return "\n".join(lines).lstrip("\n") + "\n"


def add_chinese_comments(base, app_name, options):
    level = options["comment_level"]
    extensions = {".swift", ".h", ".m"}
    for directory_name in ("Sources", "Tests", "UITests"):
        directory = base / directory_name
        if not directory.exists():
            continue
        for path in sorted(item for item in directory.rglob("*") if item.suffix in extensions):
            content = strip_generated_file_header(path.read_text(encoding="utf-8"))
            content = strip_generated_file_explanations(content)
            annotated = annotate_declarations(content, path, level)
            path.write_text(annotated, encoding="utf-8")


def swift_tokens(tokens, framework="SwiftUI"):
    lines = [f"import {framework}", "", "enum DesignTokens {"]
    groups = (
        ("Spacing", tokens["spacing"]),
        ("Radius", tokens["radius"]),
        ("ControlHeight", tokens["control_height"]),
        ("IconSize", tokens["icon_size"]),
        ("BorderWidth", tokens["border_width"]),
        ("Opacity", tokens["opacity"]),
        ("AnimationDuration", tokens["animation_duration"]),
    )
    for group_name, values in groups:
        lines.append(f"    enum {group_name} {{")
        for name, value in values.items():
            lines.append(f"        static let {lower_camel(name)}: CGFloat = {value}")
        lines.extend(("    }", ""))
    lines.extend((
        "    enum Layout {",
        f'        static let contentMargin: CGFloat = {tokens["content_margin"]}',
        f'        static let contentMaxWidth: CGFloat = {tokens["content_max_width"]}',
        f'        static let minimumTapTarget: CGFloat = {tokens["minimum_tap_target"]}',
        "    }",
        "",
        "    enum Typography {",
    ))
    for name, style in tokens["typography"].items():
        ui_kit_style = "caption1" if style == "caption" else style
        expression = f"Font.{style}" if framework == "SwiftUI" else f"UIFont.preferredFont(forTextStyle: .{ui_kit_style})"
        lines.append(f"        static let {lower_camel(name)} = {expression}")
    lines.extend(("    }", "", "    enum Colors {"))
    for name, color in tokens["colors"].items():
        expression = f"Color(UIColor.{color})" if framework == "SwiftUI" else f"UIColor.{color}"
        lines.append(f"        static let {lower_camel(name)} = {expression}")
    lines.extend(("    }", "}"))
    return "\n".join(lines)


def objc_tokens(prefix, tokens):
    constants = []
    for group_name, values in (
        ("Spacing", tokens["spacing"]),
        ("Radius", tokens["radius"]),
        ("ControlHeight", tokens["control_height"]),
        ("IconSize", tokens["icon_size"]),
        ("BorderWidth", tokens["border_width"]),
        ("Opacity", tokens["opacity"]),
        ("AnimationDuration", tokens["animation_duration"]),
    ):
        for name, value in values.items():
            constants.append((f"{prefix}{group_name}{upper_camel(name)}", value))
    constants.extend((
        (f"{prefix}ContentMargin", tokens["content_margin"]),
        (f"{prefix}ContentMaxWidth", tokens["content_max_width"]),
        (f"{prefix}MinimumTapTarget", tokens["minimum_tap_target"]),
    ))
    header = ["#import <UIKit/UIKit.h>", "", "NS_ASSUME_NONNULL_BEGIN"]
    implementation = [f'#import "{prefix}DesignTokens.h"', ""]
    for name, value in constants:
        header.append(f"FOUNDATION_EXPORT const CGFloat {name};")
        implementation.append(f"const CGFloat {name} = {value};")
    header.append("")
    for name, color in tokens["colors"].items():
        function = f"{prefix}Color{upper_camel(name)}"
        header.append(f"FOUNDATION_EXPORT UIColor *{function}(void);")
        implementation.append(f"UIColor *{function}(void) {{ return UIColor.{color}Color; }}")
    header.append("")
    for name, style in tokens["typography"].items():
        function = f"{prefix}Font{upper_camel(name)}"
        ui_kit_style = "caption1" if style == "caption" else style
        header.append(f"FOUNDATION_EXPORT UIFont *{function}(void);")
        implementation.append(
            f"UIFont *{function}(void) {{ return [UIFont preferredFontForTextStyle:UIFontTextStyle{upper_camel(ui_kit_style)}]; }}"
        )
    header.append("NS_ASSUME_NONNULL_END")
    return "\n".join(header), "\n".join(implementation)


def generate_swiftui(base, app_name, architecture, navigation_enabled, tokens):
    source = base / "Sources"
    write(source / "App" / f"{app_name}App.swift", f'''import SwiftUI

@main
struct {app_name}App: App {{
    var body: some Scene {{
        WindowGroup {{
            HomeView()
        }}
    }}
}}''')
    if architecture == "mvvm":
        write(source / "Features" / "Home" / "HomeViewModel.swift", '''import Combine

@MainActor
final class HomeViewModel: ObservableObject {
    @Published private(set) var title = "Hello, iOS!"
}''')
        if navigation_enabled:
            content = '''        NavigationView {
            Text(viewModel.title)
                .padding(DesignTokens.Spacing.lg)
                .navigationTitle("Home")
        }'''
        else:
            content = '''        Text(viewModel.title)
            .padding(DesignTokens.Spacing.lg)'''
        write(source / "Features" / "Home" / "HomeView.swift", f'''import SwiftUI

struct HomeView: View {{
    @StateObject private var viewModel = HomeViewModel()

    var body: some View {{
{content}
    }}
}}

struct HomeView_Previews: PreviewProvider {{
    static var previews: some View {{ HomeView() }}
}}''')
    else:
        write(source / "Features" / "Home" / "HomeController.swift", '''import Combine

@MainActor
final class HomeController: ObservableObject {
    @Published private(set) var title = "Hello, iOS!"
}''')
        if navigation_enabled:
            content = '''        NavigationView {
            Text(controller.title)
                .padding(DesignTokens.Spacing.lg)
                .navigationTitle("Home")
        }'''
        else:
            content = '''        Text(controller.title)
            .padding(DesignTokens.Spacing.lg)'''
        write(source / "Features" / "Home" / "HomeView.swift", f'''import SwiftUI

struct HomeView: View {{
    @StateObject private var controller = HomeController()

    var body: some View {{
{content}
    }}
}}

struct HomeView_Previews: PreviewProvider {{
    static var previews: some View {{ HomeView() }}
}}''')
    write(source / "DesignSystem" / "DesignTokens.swift", swift_tokens(tokens))


def generate_swift_uikit(base, app_name, architecture, navigation_enabled, tokens):
    source = base / "Sources"
    write(source / "App" / "AppDelegate.swift", '''import UIKit

@main
final class AppDelegate: UIResponder, UIApplicationDelegate {
    func application(
        _ application: UIApplication,
        configurationForConnecting connectingSceneSession: UISceneSession,
        options: UIScene.ConnectionOptions
    ) -> UISceneConfiguration {
        UISceneConfiguration(name: "Default Configuration", sessionRole: connectingSceneSession.role)
    }
}''')
    root_view_controller = (
        "UINavigationController(rootViewController: HomeViewController())"
        if navigation_enabled else "HomeViewController()"
    )
    write(source / "App" / "SceneDelegate.swift", f'''import UIKit

final class SceneDelegate: UIResponder, UIWindowSceneDelegate {{
    var window: UIWindow?

    func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options: UIScene.ConnectionOptions) {{
        guard let windowScene = scene as? UIWindowScene else {{ return }}
        let window = UIWindow(windowScene: windowScene)
        window.rootViewController = {root_view_controller}
        window.makeKeyAndVisible()
        self.window = window
    }}
}}''')
    if architecture == "mvvm":
        write(source / "Features" / "Home" / "HomeViewModel.swift", '''import Foundation

final class HomeViewModel {
    let title = "Hello, iOS!"
}''')
        extra = "    private let viewModel = HomeViewModel()\n"
        title = "viewModel.title"
    else:
        extra = ""
        title = '"Hello, iOS!"'
    write(source / "Features" / "Home" / "HomeViewController.swift", f'''import UIKit

final class HomeViewController: UIViewController {{
{extra}
    override func viewDidLoad() {{
        super.viewDidLoad()
        title = "Home"
        view.backgroundColor = .systemBackground

        let label = UILabel()
        label.text = {title}
        label.font = .preferredFont(forTextStyle: .title2)
        label.translatesAutoresizingMaskIntoConstraints = false
        view.addSubview(label)
        NSLayoutConstraint.activate([
            label.centerXAnchor.constraint(equalTo: view.centerXAnchor),
            label.centerYAnchor.constraint(equalTo: view.centerYAnchor)
        ])
    }}
}}''')
    write(source / "DesignSystem" / "DesignTokens.swift", swift_tokens(tokens, framework="UIKit"))


def generate_objc_uikit(base, app_name, architecture, navigation_enabled, prefix, tokens):
    source = base / "Sources"
    app_delegate = f"{prefix}AppDelegate"
    scene_delegate = f"{prefix}SceneDelegate"
    home_controller = f"{prefix}HomeViewController"
    home_view_model = f"{prefix}HomeViewModel"
    write(source / "App" / "main.m", f'''#import <UIKit/UIKit.h>
#import "{app_delegate}.h"

int main(int argc, char * argv[]) {{
    @autoreleasepool {{
        return UIApplicationMain(argc, argv, nil, NSStringFromClass({app_delegate}.class));
    }}
}}''')
    write(source / "App" / f"{app_delegate}.h", f'''#import <UIKit/UIKit.h>

NS_ASSUME_NONNULL_BEGIN
@interface {app_delegate} : UIResponder <UIApplicationDelegate>
@end
NS_ASSUME_NONNULL_END''')
    write(source / "App" / f"{app_delegate}.m", f'''#import "{app_delegate}.h"

@implementation {app_delegate}
- (UISceneConfiguration *)application:(UIApplication *)application
    configurationForConnectingSceneSession:(UISceneSession *)connectingSceneSession
    options:(UISceneConnectionOptions *)options {{
    return [[UISceneConfiguration alloc] initWithName:@"Default Configuration"
                                          sessionRole:connectingSceneSession.role];
}}
@end''')
    write(source / "App" / f"{scene_delegate}.h", f'''#import <UIKit/UIKit.h>

NS_ASSUME_NONNULL_BEGIN
@interface {scene_delegate} : UIResponder <UIWindowSceneDelegate>
@property (strong, nonatomic) UIWindow *window;
@end
NS_ASSUME_NONNULL_END''')
    if navigation_enabled:
        root_setup = f'''    self.window.rootViewController = [[UINavigationController alloc]
        initWithRootViewController:[[{home_controller} alloc] init]];'''
    else:
        root_setup = f"    self.window.rootViewController = [[{home_controller} alloc] init];"
    write(source / "App" / f"{scene_delegate}.m", f'''#import "{scene_delegate}.h"
#import "{home_controller}.h"

@implementation {scene_delegate}
- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session
    options:(UISceneConnectionOptions *)connectionOptions {{
    if (![scene isKindOfClass:UIWindowScene.class]) {{ return; }}
    self.window = [[UIWindow alloc] initWithWindowScene:(UIWindowScene *)scene];
{root_setup}
    [self.window makeKeyAndVisible];
}}
@end''')
    if architecture == "mvvm":
        write(source / "Features" / "Home" / f"{home_view_model}.h", f'''#import <Foundation/Foundation.h>

NS_ASSUME_NONNULL_BEGIN
@interface {home_view_model} : NSObject
@property (nonatomic, copy, readonly) NSString *title;
@end
NS_ASSUME_NONNULL_END''')
        write(source / "Features" / "Home" / f"{home_view_model}.m", f'''#import "{home_view_model}.h"

@implementation {home_view_model}
- (NSString *)title {{ return @"Hello, iOS!"; }}
@end''')
        import_line = f'#import "{home_view_model}.h"\n'
        setup = f"    {home_view_model} *viewModel = [[{home_view_model} alloc] init];\n    label.text = viewModel.title;"
    else:
        import_line = ""
        setup = '    label.text = @"Hello, iOS!";'
    write(source / "Features" / "Home" / f"{home_controller}.h", f'''#import <UIKit/UIKit.h>

NS_ASSUME_NONNULL_BEGIN
@interface {home_controller} : UIViewController
@end
NS_ASSUME_NONNULL_END''')
    write(source / "Features" / "Home" / f"{home_controller}.m", f'''#import "{home_controller}.h"
{import_line}
@implementation {home_controller}
- (void)viewDidLoad {{
    [super viewDidLoad];
    self.title = @"Home";
    self.view.backgroundColor = UIColor.systemBackgroundColor;
    UILabel *label = [[UILabel alloc] init];
{setup}
    label.font = [UIFont preferredFontForTextStyle:UIFontTextStyleTitle2];
    label.translatesAutoresizingMaskIntoConstraints = NO;
    [self.view addSubview:label];
    [NSLayoutConstraint activateConstraints:@[
        [label.centerXAnchor constraintEqualToAnchor:self.view.centerXAnchor],
        [label.centerYAnchor constraintEqualToAnchor:self.view.centerYAnchor]
    ]];
}}
@end''')
    token_header, token_implementation = objc_tokens(prefix, tokens)
    write(source / "DesignSystem" / f"{prefix}DesignTokens.h", token_header)
    write(source / "DesignSystem" / f"{prefix}DesignTokens.m", token_implementation)


def project_yml(app_name, options):
    device_codes = {"iphone": "1", "ipad": "2"}
    target_devices = ",".join(device_codes[device] for device in options["target_devices"])
    sign_style = options["code_sign_style"].capitalize()
    warnings = "YES" if options["warnings_as_errors"] else "NO"
    lines = [
        f"name: {app_name}",
        "options:",
        f'  bundleIdPrefix: {options["bundle_id_prefix"]}',
        f'  developmentLanguage: {options["default_localization"]}',
        "  deploymentTarget:",
        f'    iOS: "{options["deployment_target"]}"',
        "attributes:",
        f'  ORGANIZATIONNAME: "{options["organization_name"]}"',
        "settings:",
        "  base:",
        f'    MARKETING_VERSION: "{options["marketing_version"]}"',
        f'    CURRENT_PROJECT_VERSION: "{options["build_number"]}"',
        f"    CODE_SIGN_STYLE: {sign_style}",
        f"    GCC_TREAT_WARNINGS_AS_ERRORS: {warnings}",
    ]
    if options["development_team"]:
        lines.append(f'    DEVELOPMENT_TEAM: "{options["development_team"]}"')
    if options["language"] == "swift":
        lines.extend((
            f'    SWIFT_VERSION: "{options["swift_version"]}"',
            f'    SWIFT_STRICT_CONCURRENCY: {options["strict_concurrency"]}',
            f"    SWIFT_TREAT_WARNINGS_AS_ERRORS: {warnings}",
        ))
    else:
        lines.append("    CLANG_ENABLE_OBJC_ARC: YES")
    lines.extend((
        "targets:",
        f"  {app_name}:",
        "    type: application",
        "    platform: iOS",
        "    sources:",
        "      - Sources",
        "      - path: Resources",
        "        excludes:",
        "          - Info.plist",
        "    settings:",
        "      base:",
        f"        PRODUCT_NAME: {app_name}",
        f'        PRODUCT_BUNDLE_IDENTIFIER: {options["bundle_id"]}',
        "        INFOPLIST_FILE: Resources/Info.plist",
        f'        TARGETED_DEVICE_FAMILY: "{target_devices}"',
    ))
    if options["include_unit_tests"]:
        lines.extend((
            f"  {app_name}Tests:",
            "    type: bundle.unit-test",
            "    platform: iOS",
            "    sources:",
            "      - Tests",
            "    dependencies:",
            f"      - target: {app_name}",
        ))
    if options["include_ui_tests"]:
        lines.extend((
            f"  {app_name}UITests:",
            "    type: bundle.ui-testing",
            "    platform: iOS",
            "    sources:",
            "      - UITests",
            "    dependencies:",
            f"      - target: {app_name}",
        ))
    return "\n".join(lines)


def info_plist(app_name, options):
    if options["ui"] == "swiftui":
        scene_manifest = ""
    else:
        scene_class = ("$(PRODUCT_MODULE_NAME).SceneDelegate" if options["language"] == "swift"
                       else options["objc_class_prefix"] + "SceneDelegate")
        scene_manifest = f'''<key>UIApplicationSceneManifest</key><dict>
  <key>UIApplicationSupportsMultipleScenes</key><false/>
  <key>UISceneConfigurations</key><dict>
    <key>UIWindowSceneSessionRoleApplication</key><array><dict>
      <key>UISceneConfigurationName</key><string>Default Configuration</string>
      <key>UISceneDelegateClassName</key><string>{scene_class}</string>
    </dict></array>
  </dict>
</dict>'''
    return f'''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDevelopmentRegion</key><string>{options["default_localization"]}</string>
<key>AppDefaultLanguageMode</key><string>{options["default_language_mode"]}</string>
<key>AppDefaultLocalization</key><string>{options["default_localization"]}</string>
<key>CFBundleDisplayName</key><string>{app_name}</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundlePackageType</key><string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict/>
{scene_manifest}
</dict></plist>'''


def privacy_manifest():
    return '''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>NSPrivacyTracking</key><false/>
<key>NSPrivacyTrackingDomains</key><array/>
<key>NSPrivacyCollectedDataTypes</key><array/>
<key>NSPrivacyAccessedAPITypes</key><array/>
</dict></plist>'''


