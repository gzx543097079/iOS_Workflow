def localized_home_title(localization):
    titles = {
        "zh-Hans": "首页",
        "zh-Hant": "首頁",
        "en": "Home",
        "es": "Inicio",
        "fr": "Accueil",
        "de": "Startseite",
        "ja": "ホーム",
        "ko": "홈",
        "pt-BR": "Início",
        "it": "Home",
        "ar": "الرئيسية",
        "ru": "Главная",
    }
    return titles.get(localization, "Home")


def generate_tests(base, app_name, options):
    if options["include_unit_tests"]:
        if options["language"] == "swift":
            write(base / "Tests" / f"{app_name}Tests.swift", f'''import XCTest
@testable import {app_name}

final class {app_name}Tests: XCTestCase {{
    // TODO: 用真实业务场景替换占位测试，并补充成功、失败和边界条件。
    func testExample() {{
        XCTAssertTrue(true)
    }}
}}''')
        else:
            write(base / "Tests" / f"{app_name}Tests.m", f'''#import <XCTest/XCTest.h>

@interface {app_name}Tests : XCTestCase
@end

@implementation {app_name}Tests
// TODO: 用真实业务场景替换占位测试，并补充成功、失败和边界条件。
- (void)testExample {{
    XCTAssertTrue(YES);
}}
@end''')
    if options["include_ui_tests"]:
        if options["language"] == "swift":
            write(base / "UITests" / f"{app_name}UITests.swift", f'''import XCTest

final class {app_name}UITests: XCTestCase {{
    // TODO: 用关键用户流程替换占位启动测试，并验证可观察的界面结果。
    func testLaunch() {{
        let app = XCUIApplication()
        app.launch()
        XCTAssertTrue(app.exists)
    }}
}}''')
        else:
            write(base / "UITests" / f"{app_name}UITests.m", f'''#import <XCTest/XCTest.h>

@interface {app_name}UITests : XCTestCase
@end

@implementation {app_name}UITests
// TODO: 用关键用户流程替换占位启动测试，并验证可观察的界面结果。
- (void)testLaunch {{
    XCUIApplication *app = [[XCUIApplication alloc] init];
    [app launch];
    XCTAssertTrue(app.exists);
}}
@end''')


def generate_dependency_manager_files(base, app_name, options):
    manager = options["dependency_manager"]
    if manager == "pod":
        write(base / "Podfile", f'''platform :ios, '{options["deployment_target"]}'

project '{app_name}.xcodeproj'

target '{app_name}' do
    # 在此添加 pod，例如：pod 'Alamofire'
end''')
    elif manager == "carthage":
        write(base / "Cartfile", '''# 在此添加依赖，例如：
# github "Alamofire/Alamofire"''')


def generate_project(args):
    defaults = load_defaults()
    tokens = load_design_tokens()
    options = dict(defaults)
    overrides = {
        "language": getattr(args, "language", None),
        "ui": getattr(args, "ui", None),
        "architecture": getattr(args, "architecture", None),
        "navigation_enabled": getattr(args, "navigation_enabled", None),
        "dependency_manager": getattr(args, "dependency_manager", None),
        "bundle_id_prefix": getattr(args, "bundle_id_prefix", None),
        "bundle_id": getattr(args, "bundle_id", None),
        "deployment_target": getattr(args, "deployment_target", None),
        "objc_class_prefix": getattr(args, "objc_prefix", None),
        "default_language_mode": getattr(args, "default_language_mode", None),
        "default_localization": getattr(args, "default_localization", None),
        "comment_level": getattr(args, "comment_level", None),
    }
    options.update({key: value for key, value in overrides.items() if value is not None})
    app_name = swift_identifier(args.name)
    if not options["bundle_id"]:
        options["bundle_id"] = f'{options["bundle_id_prefix"]}.{app_name.lower()}'
    validate_options(options)
    output_parent = Path(args.output).expanduser().resolve()
    destination = output_parent / app_name
    if destination.exists():
        if not args.force or any(destination.iterdir()):
            raise WorkflowError(f"目标目录已存在且非空: {destination}")
    destination.mkdir(parents=True, exist_ok=True)

    if options["language"] == "swift" and options["ui"] == "swiftui":
        generate_swiftui(
            destination, app_name, options["architecture"], options["navigation_enabled"], tokens
        )
    elif options["language"] == "swift":
        generate_swift_uikit(
            destination, app_name, options["architecture"], options["navigation_enabled"], tokens
        )
    else:
        generate_objc_uikit(
            destination,
            app_name,
            options["architecture"],
            options["navigation_enabled"],
            options["objc_class_prefix"],
            tokens,
        )

    write(destination / "project.yml", project_yml(app_name, options))
    write(destination / "Resources" / "Info.plist", info_plist(app_name, options))
    write(destination / "Resources" / "Assets.xcassets" / "Contents.json", '{"info":{"author":"xcode","version":1}}')
    write(destination / "Resources" / "Assets.xcassets" / "AppIcon.appiconset" / "Contents.json", app_icon_contents())
    for localization in options["supported_localizations"]:
        title = localized_home_title(localization)
        write(
            destination / "Resources" / f"{localization}.lproj" / "Localizable.strings",
            f'"home.title" = "{title}";',
        )
    if options["generate_privacy_manifest"]:
        write(destination / "Resources" / "PrivacyInfo.xcprivacy", privacy_manifest())
    generate_tests(destination, app_name, options)
    add_chinese_comments(destination, app_name, options)
    generate_dependency_manager_files(destination, app_name, options)
    write(destination / ".gitignore", '''DerivedData/
.build/
Pods/
Carthage/Build/
*.xcuserstate
xcuserdata/
.DS_Store''')
    write(destination / ".editorconfig", '''root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true''')
    write(destination / ".swiftlint.yml", '''disabled_rules:
  - trailing_whitespace
opt_in_rules:
  - empty_count
  - force_unwrapping
line_length:
  warning: 120
  error: 160
excluded:
  - DerivedData''')
    write(destination / "workflow.json", json.dumps({"project_name": app_name, **options}, ensure_ascii=False, indent=2))
    shutil.copytree(ROOT / "standards", destination / "Standards", dirs_exist_ok=True)
    shutil.copy2(ROOT / "checklists" / "pre-commit-review.md", destination / "Checklist.md")

    generated = False
    should_generate_xcodeproj = options["generate_xcodeproj"] and not args.no_xcodegen
    xcodegen = shutil.which("xcodegen")
    if should_generate_xcodeproj and xcodegen:
        result = subprocess.run([xcodegen, "generate"], cwd=destination, check=False)
        if result.returncode != 0:
            raise WorkflowError("源码已生成，但 XcodeGen 执行失败")
        generated = True
    print(f"已创建: {destination}")
    print(f"组合: {options['language']} + {options['ui']} + {options['architecture']}")
    if generated:
        print(f"工程: {destination / (app_name + '.xcodeproj')}")
    elif should_generate_xcodeproj:
        print("未检测到 XcodeGen。安装后在项目目录执行 xcodegen generate")


def validate_repository():
    defaults = load_defaults()
    validate_options(defaults)
    tokens = load_design_tokens()
    required = [
        "spacing", "radius", "content_margin", "content_max_width", "minimum_tap_target",
        "control_height", "icon_size", "border_width", "opacity", "animation_duration",
        "typography", "colors",
    ]
    missing = [key for key in required if key not in tokens]
    if missing:
        raise WorkflowError("design tokens 缺少字段: " + ", ".join(missing))
    for path in (
        ROOT / "standards" / "code-style.md",
        ROOT / "standards" / "ui-style.md",
        ROOT / "checklists" / "pre-commit-review.md",
        ROOT / "AGENTS.md",
    ):
        if not path.exists() or not path.read_text(encoding="utf-8").strip():
            raise WorkflowError(f"缺少或为空: {path}")
    print("工作流配置与规范校验通过")


def run_checklist(project_path, purpose):
    project = Path(project_path).expanduser().resolve()
    if not project.is_dir():
        raise WorkflowError(f"checklist 目录不存在: {project}")

    failures = []
    checklist_file = project / "Checklist.md"
    if project == ROOT:
        checklist_file = ROOT / "checklists" / "pre-commit-review.md"
    if checklist_file.is_file():
        print(f"[通过] Checklist 文档: {checklist_file}")
        checklist_content = checklist_file.read_text(encoding="utf-8")
        required_sections = ("## 订阅检查", "## 数据打点检查")
        missing_sections = [section for section in required_sections if section not in checklist_content]
        if missing_sections:
            failures.append("Checklist 缺少模块: " + ", ".join(missing_sections))
        else:
            print("[通过] Checklist 包含订阅与数据打点检查模块")
    else:
        failures.append(f"缺少 Checklist 文档: {checklist_file}")

    workflow_path = project / "workflow.json"
    if workflow_path.exists():
        try:
            project_options = json.loads(workflow_path.read_text(encoding="utf-8"))
            validate_options(project_options)
            print("[通过] workflow.json 配置有效")
        except (OSError, json.JSONDecodeError, WorkflowError) as exc:
            failures.append(f"workflow.json 配置无效: {exc}")
    elif project == ROOT:
        try:
            validate_options(load_defaults())
            print("[通过] 工作流默认配置有效")
        except WorkflowError as exc:
            failures.append(str(exc))
    else:
        failures.append(f"缺少项目配置: {workflow_path}")

    test_directories = [path for name in ("Tests", "UITests", "tests") if (path := project / name).is_dir()]
    if not test_directories:
        failures.append("未找到 Tests、UITests 或 tests 目录")
    unresolved_todos = []
    test_extensions = {".swift", ".m", ".mm", ".py"}
    for directory in test_directories:
        for path in sorted(item for item in directory.rglob("*") if item.suffix in test_extensions):
            for line_number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
                if re.search(r"\bTODO\b", line):
                    unresolved_todos.append(f"{path.relative_to(project)}:{line_number}")
    if unresolved_todos:
        failures.append("测试中存在未处理 TODO: " + ", ".join(unresolved_todos))
    else:
        print("[通过] 测试中没有未处理 TODO")

    for label, arguments in (
        ("未暂存", ["git", "diff", "--check", "--", "."]),
        ("已暂存", ["git", "diff", "--cached", "--check", "--", "."]),
    ):
        git_check = subprocess.run(
            arguments,
            cwd=project,
            check=False,
            capture_output=True,
            text=True,
        )
        if git_check.returncode == 0:
            print(f"[通过] Git {label} diff 格式检查")
        elif "not a git repository" in git_check.stderr.lower():
            print("[跳过] 当前目录不在 Git 仓库中")
            break
        else:
            failures.append(
                f"Git {label} diff 格式检查失败:\n" + (git_check.stdout or git_check.stderr).strip()
            )

    if failures:
        details = "\n- ".join(failures)
        raise WorkflowError(f"{purpose} checklist 未通过:\n- {details}")
    print(f"{purpose} checklist 自动检查通过；请继续完成 {checklist_file.name} 中的人工检查项")


def doctor():
    checks = {
        "Python 3": sys.version.split()[0],
        "XcodeGen": shutil.which("xcodegen") or "未安装（源码生成可用，.xcodeproj 生成不可用）",
        "xcodebuild": shutil.which("xcodebuild") or "未安装",
        "SwiftLint": shutil.which("swiftlint") or "未安装（可选）",
        "SwiftFormat": shutil.which("swiftformat") or "未安装（可选）",
    }
    for name, value in checks.items():
        print(f"{name}: {value}")


def parser():
    defaults = load_defaults()
    root = argparse.ArgumentParser(prog="iosflow", description="iOS AI 工作流")
    commands = root.add_subparsers(dest="command", required=True)
    new = commands.add_parser("new", help="生成空项目")
    new.add_argument("name")
    new.add_argument("--language", choices=VALID["language"])
    new.add_argument("--ui", choices=VALID["ui"])
    new.add_argument("--architecture", choices=VALID["architecture"])
    navigation = new.add_mutually_exclusive_group()
    navigation.add_argument("--navigation", dest="navigation_enabled", action="store_true", default=None)
    navigation.add_argument("--no-navigation", dest="navigation_enabled", action="store_false")
    new.add_argument("--dependency-manager", choices=VALID["dependency_manager"])
    new.add_argument("--bundle-id-prefix")
    new.add_argument("--bundle-id")
    new.add_argument("--deployment-target")
    new.add_argument("--objc-prefix")
    new.add_argument("--default-language-mode", choices=VALID["default_language_mode"])
    new.add_argument("--default-localization")
    new.add_argument("--comment-level", type=int, choices=VALID["comment_level"])
    new.add_argument("--output", default=os.getcwd())
    new.add_argument("--no-xcodegen", action="store_true")
    new.add_argument("--force", action="store_true")
    commands.add_parser("validate", help="校验配置和规范")
    checklist = commands.add_parser("checklist", help="执行提交或 review 前检查")
    checklist.add_argument("path", nargs="?", default=os.getcwd())
    checklist.add_argument("--purpose", choices=("commit", "review"), default="commit")
    commands.add_parser("doctor", help="检查本机工具")
    commands.add_parser("list-options", help="显示可选项和默认值")
    return root, defaults


def main():
    try:
        command_parser, defaults = parser()
        args = command_parser.parse_args()
        if args.command == "new":
            generate_project(args)
        elif args.command == "validate":
            validate_repository()
        elif args.command == "doctor":
            doctor()
        elif args.command == "checklist":
            run_checklist(args.path, args.purpose)
        else:
            print(json.dumps({"options": VALID, "defaults": defaults}, ensure_ascii=False, indent=2))
    except WorkflowError as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
