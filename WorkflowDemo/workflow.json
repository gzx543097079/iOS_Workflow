{
  "language": "swift",
  "ui": "uikit",
  "architecture": "mvvm",
  "navigation_enabled": true,
  "dependency_manager": "none",
  "bundle_id_prefix": "com.example",
  "bundle_id": "com.example.workflowdemo",
  "deployment_target": "14.0",
  "swift_version": "5.10",
  "marketing_version": "1.0",
  "build_number": "1",
  "organization_name": "Workflow Demo",
  "objc_class_prefix": "WFD",
  "development_team": "",
  "code_sign_style": "automatic",
  "target_devices": [
    "iphone",
    "ipad"
  ],
  "default_language_mode": "system",
  "default_localization": "en",
  "supported_localizations": [
    "zh-Hans",
    "zh-Hant",
    "en",
    "es",
    "fr",
    "de",
    "ja",
    "ko",
    "pt-BR",
    "it",
    "ar",
    "ru"
  ],
  "include_unit_tests": true,
  "include_ui_tests": true,
  "test_framework": "xctest",
  "comment_level": 3,
  "strict_concurrency": "complete",
  "warnings_as_errors": false,
  "generate_privacy_manifest": true,
  "generate_xcodeproj": true
}
