{
  "schema_version": 1,
  "project_name": "MyProject",
  "config": {
    "language": "swift",
    "ui": "uikit",
    "architecture": "mvvm",
    "navigation_enabled": true,
    "dependency_manager": "pod",
    "bundle_id_prefix": "com.yourcompany",
    "bundle_id": "",
    "deployment_target": "14.0",
    "swift_version": "5",
    "marketing_version": "1.0",
    "build_number": "1",
    "organization_name": "Test Team",
    "objc_class_prefix": "APP",
    "development_team": "",
    "code_sign_style": "automatic",
    "supported_orientations": [],
    "target_devices": [
      "iphone",
      "ipad"
    ],
    "supports_dark_mode": true,
    "supports_manual_dark_mode_switch": false,
    "default_language_mode": "system",
    "default_localization": "en",
    "supported_localizations": [
      "zh-Hans",
      "zh-Hant",
      "en",
      "es",
      "fr",
      "de",
      "ja",
      "ko",
      "pt-BR",
